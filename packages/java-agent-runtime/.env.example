# Pi 进程配置；其余变量保持与旧 Python Runtime 完全同名。
PI_RUNTIME_PORT=8000
PI_RUNTIME_CWD=.
PI_RUNTIME_SESSION_DIR=sessions
# 默认静态目录为 packages/java-agent-runtime/static/manage-console
# PI_RUNTIME_MANAGE_CONSOLE_DIR=packages/java-agent-runtime/static/manage-console

MCP_BASE_URL=http://127.0.0.1:10002/epservice/ai/mcp
MCP_API_TOKEN=AAA
MCP_TIMEOUT_SECONDS=10

# 省略时由 MCP_BASE_URL 去掉 /ai/mcp 自动推导。
# JAVA_GATEWAY_BASE_URL=http://127.0.0.1:10002/epservice

AI_GATEWAY_INTERNAL_TOKEN=AAA
AI_GATEWAY_CONTEXT_SIGN_SECRET=change-me-in-dev
AI_GATEWAY_CLOCK_SKEW_SECONDS=30

QWEN_MODEL=qwen3.7-plus
QWEN_API_KEY=
QWEN_API_KEY_FILE=config/apikey.txt
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# Pi Provider 名称；通常无需改动。
# PI_RUNTIME_MODEL_PROVIDER=dashscope
