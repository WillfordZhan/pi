# Compose 使用该变量定位 docker load 导入的镜像。
PI_RUNTIME_IMAGE=pi-java-agent-runtime:dev

# 以下三个值必须与 Star2 Java iot-app 的 AI Gateway/MCP 配置保持一致。
MCP_API_TOKEN=replace-me
AI_GATEWAY_INTERNAL_TOKEN=replace-me
AI_GATEWAY_CONTEXT_SIGN_SECRET=replace-me

# 沿用当前 DEV 环境模型；Qwen API Key 单独放在 config/apikey.txt。
QWEN_MODEL=qwen-plus

